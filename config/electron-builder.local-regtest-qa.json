{
  "appId": "com.wcashwallet.wallet.local-regtest-qa",
  "productName": "Wcash Wallet",
  "buildVersion": "180.1",
  "artifactName": "Wcash-Wallet-LOCAL-REGTEST-QA-UNSIGNED-${version}-${buildVersion}-${arch}.${ext}",
  "forceCodeSigning": false,
  "npmRebuild": false,
  "extraMetadata": {
    "name": "wcash-wallet-local-regtest-qa",
    "productName": "Wcash Wallet",
    "description": "Unsigned Wcash Wallet local Regtest QA build; funds have no monetary value",
    "homepage": "https://github.com/w-cash/wallet-desktop",
    "wcashPackagedProfile": "local-regtest-qa"
  },
  "afterPack": "./scripts/verify-wcash-local-regtest-qa-after-pack.js",
  "files": [
    "build/**/*",
    "node_modules/**/*"
  ],
  "asarUnpack": [
    "build/native.node",
    "node_modules/keytar/**/*.node"
  ],
  "directories": {
    "buildResources": "public",
    "output": "dist/local-regtest-qa"
  },
  "mac": {
    "category": "public.app-category.finance",
    "identity": null,
    "target": [
      "zip"
    ],
    "icon": "./resources/icon.icns"
  }
}
